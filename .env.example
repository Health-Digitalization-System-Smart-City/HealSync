# -----------------------------------------------------------------------------
# HealSync — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (Prisma 7 reads this from
# prisma.config.ts). Example for a local database:
#   postgresql://postgres:postgres@localhost:5432/healsync
# For more connection-string options see:
#   https://www.prisma.io/docs/orm/reference/connection-urls
DATABASE_URL=

# Better Auth secret used to sign session cookies and tokens.
# Generate one with:  openssl rand -base64 32
# REQUIRED. Better Auth refuses to initialize without it (dev and build
# included). Must be at least 32 characters.
BETTER_AUTH_SECRET=

# Public base URL of the application (no trailing slash).
# Local development: http://localhost:3000
BETTER_AUTH_URL=

# Resend API key — used to send password-reset emails (optional in dev).
# When unset, reset links are logged to the server console instead.
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=

# From address for auth emails (optional; default: HealSync <no-reply@healsync.com>).
# Must be from a domain verified in Resend.
EMAIL_FROM=

# -----------------------------------------------------------------------------
# AI Insights (Phase 1) — Vercel AI SDK
# -----------------------------------------------------------------------------
# Provider + model used by the dashboard AI Insights section. The provider
# abstraction in src/lib/ai keeps the rest of the app decoupled from the SDK,
# so the provider/model can be swapped via configuration alone.
#
# AI_PROVIDER: currently supports "google" (Gemini).
# AI_MODEL:    model id passed to the provider. Default: gemini-2.5-flash
#              (a free-tier Gemini model; get a key from Google AI Studio).
# AI_API_KEY:  server-side API key for the provider. Never expose via
#              NEXT_PUBLIC_*. When unset, the AI Insights section shows its
#              graceful "unavailable" state and the dashboard keeps working.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# -----------------------------------------------------------------------------
# AI Insights (Phase 2) — page + Ask AI tuning
# -----------------------------------------------------------------------------
# How long a forced "Refresh Analysis" must wait before calling the LLM again
# (ms). Protects the AI quota from refresh spam. Default: 60000.
AI_REFRESH_COOLDOWN_MS=60000

# Ask AI — per-user rate limit and question-length cap (PRD §31).
# Defaults: 10 requests per minute, 500-char questions.
AI_ASK_MAX_REQUESTS_PER_MINUTE=10
AI_ASK_MAX_LENGTH=500
