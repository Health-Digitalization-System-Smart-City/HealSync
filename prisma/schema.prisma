// Prisma schema — Smart Feedback
//
// Implements the data model documented in docs/DATABASE.md (§32 "Recommended
// Prisma Domain Model"): authentication (Better Auth), RBAC
// (roles/permissions), branches, services, feedback, and audit logging.
//
// Source-of-truth chain (database.md §34):
//   PRD.md → database.md → schema.prisma → Prisma migrations
//
// Prisma 7 notes:
// - The `prisma-client` generator (new default) emits the client to a custom
//   output directory instead of node_modules. See `output` below.
// - The datasource block only declares the provider; the connection URL is
//   configured in prisma.config.ts.
// - The client requires a driver adapter at runtime (@prisma/adapter-pg),
//   wired up in src/lib/db/index.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication — Better Auth core models
// See: https://www.better-auth.com/docs/adapters/prisma
// ---------------------------------------------------------------------------
//
// Better Auth stores the email+password credential (including the password
// hash) in Account.password, not on User. The app-level fields below
// (roleId, isActive, lastLoginAt) extend the library's core User model per
// docs/DATABASE.md §3; the admin-plugin fields (role, banned, ...) are
// required by the admin plugin mandated in docs/SECURITY.md §9.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  // RBAC role — mirrors Role.name (Admin / Manager / Analyst) and is kept in
  // sync at provisioning time (createUser, API.md §14). Defaults to Better
  // Auth's "user" role; the dashboard treats any non-RBAC value as the
  // least-privilege Analyst fallback. See docs/SECURITY.md §2, §9.
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // App-level fields (database.md §3, §17). Users are never hard-deleted;
  // disableUser sets isActive = false (API.md §14). The initial admin is
  // created by the controlled bootstrap/seed (security.md §9).
  roleId      String? // FK → Role
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  sessions     Session[]
  accounts     Account[]
  auditLogs    AuditLog[]
  tasks        Task[]
  assignedRole Role?      @relation("UserRole", fields: [roleId], references: [id])

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // password hash for email+password (Better Auth)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// RBAC — roles, permissions, role-permission grants (database.md §4–§5)
// ---------------------------------------------------------------------------
// Roles are fixed per security.md §2 (Admin / Manager / Analyst); the system
// does not support custom roles. The exact permission matrix is defined in
// the seed (security.md §3) and is not editable through the dashboard.

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]           @relation("UserRole")
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // resource.action, e.g. "feedback.read" (API.md §8)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Branches & services (database.md §6–§8)
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchServices BranchService[]
  feedback       Feedback[]
  tasks          Task[]

  @@map("branch")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchServices BranchService[]
  feedback       Feedback[]

  @@map("service")
}

// A branch may offer multiple services and a service may be available at
// multiple branches — many-to-many with an explicit join table (database.md
// §8). branchId + serviceId is unique. Prefer deactivation (isActive = false)
// over deletion; Restrict prevents destroying historical references.

model BranchService {
  branchId  String
  serviceId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([branchId, serviceId])
  @@index([serviceId])
  @@map("branch_service")
}

// ---------------------------------------------------------------------------
// Feedback (database.md §9–§17)
// ---------------------------------------------------------------------------

// Structured rating values (database.md §12). The final list is standardized
// before production (PRD.md §33 open decision).
enum FeedbackRating {
  VERY_SATISFIED
  SATISFIED
  MOSTLY_SATISFIED
  GOOD
  NEUTRAL
  NOT_SATISFIED
  POOR
  VERY_POOR
}

model Feedback {
  id              String         @id @default(cuid())
  phoneNumber     String // normalized E.164 (database.md §11); sensitive — server-only
  phoneNumberHash String? // salted hash for duplicate-submission detection (API.md §24)
  branchId        String
  serviceId       String
  rating          FeedbackRating
  comment         String? // optional, ≤ 1,000 chars (security.md §14), original text preserved
  locale          String   @default("en") // language selected when the patient submitted feedback
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime? // soft delete (database.md §17); physical deletion only after retention period

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Indexes for the main queries: list filters and analytics aggregation
  // (database.md §21–§23).
  @@index([branchId])
  @@index([serviceId])
  @@index([createdAt])
  @@index([rating])
  @@index([branchId, createdAt])
  @@index([serviceId, createdAt])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Tasks (dashboard operational tasks)
// ---------------------------------------------------------------------------

// Operational dashboard tasks (follow-ups, inspections, equipment checks,
// protocol reviews, staffing). `priority`, `status`, and `category` are
// controlled string values matching the dashboard UI; tasks are soft-deleted
// like other app entities (database.md §17).
model Task {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  category     String   @default("Follow-up")
  priority     String   @default("medium")
  status       String   @default("pending")
  dueDate      String   @default("")
  assigneeName String   @default("Clinic Duty Lead")
  assigneeRole String   @default("Coordinator")
  branchId     String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([status])
  @@index([priority])
  @@map("task")
}

// ---------------------------------------------------------------------------
// AI insights (Phase 1 — daily; later phases add weekly/monthly/yearly)
// ---------------------------------------------------------------------------

// Persisted, validated AI analysis so the dashboard does not call the LLM on
// every render (API.md §20). `content` holds the validated structured result
// (DailyAIInsight); raw patient-identifying data is never stored here.
model AIInsight {
  id            String   @id @default(cuid())
  type          String // e.g. "daily" (Phase 1). Later phases extend this value set.
  periodStart   DateTime
  periodEnd     DateTime
  feedbackCount Int
  content       Json // validated structured AI result
  model         String? // AI model used to generate the insight
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, periodStart, periodEnd])
  @@map("ai_insight")
}

// ---------------------------------------------------------------------------
// Audit log (database.md §18–§19)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String // acting dashboard user
  action     String // e.g. create / update / delete / disable
  entityType String // e.g. branch / service / user / feedback
  entityId   String?
  metadata   Json? // structured, evolving (database.md §18)
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_log")
}
